{
  "name": "capacitor-calendar",
  "version": "2.0.1",
  "description": "Simple native calendar handling for Capacitor",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "CapacitorCalendar.podspec"
  ],
  "scripts": {
    "verify": "npm run verify:web && npm run verify:ios && npm run verify:android",
    "verify:web": "npm run build && npm test",
    "verify:ios": "xcodebuild -scheme CapacitorCalendar -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "test": "tsc -p tsconfig.test.json",
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "author": "Vladimír Fojtík <vladimir@fojtik.dev>, Břetislav Štěpán <info@bretislavstepan.cz>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "rimraf": "^6.1.4",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "calendar"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fir3st/capacitor-calendar"
  },
  "bugs": {
    "url": "https://github.com/Fir3st/capacitor-calendar/issues"
  }
}
